# Include the inputs copied by the Dockerfile.
**
!requirements.txt
!app/
!app/**

# Python environments, bytecode, and tooling caches.
**/.venv
**/venv
**/.virtualenv
**/virtualenv
**/__pycache__
**/*.py[cod]
**/$py.class
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.tox
**/.nox
**/.coverage
**/.coverage.*
**/htmlcov

# Git metadata, editor settings, logs, and temporary files.
**/.git
**/.gitignore
**/.gitattributes
**/.gitmodules
**/.idea
**/.vscode
**/.DS_Store
**/logs
**/*.log
**/*.log.*
**/tmp
**/temp
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~

# Local environment files, credentials, and private keys.
**/.env
**/.env.*
**/.envrc
**/.aws
**/.ssh
**/.netrc
**/.npmrc
**/.pypirc
**/secrets
**/secrets.*
**/credentials
**/credentials.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
