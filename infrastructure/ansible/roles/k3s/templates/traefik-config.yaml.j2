---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    service:
      spec:
        type: NodePort
    ports:
      web:
        nodePort: {{ k3s_node_port }}
      websecure:
        expose:
          default: false
    ingressRoute:
      healthcheck:
        enabled: true
        entryPoints: [web]
        matchRule: Path(`/healthcheck`)
